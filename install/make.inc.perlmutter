CC = cc
CXX = CC
CFLAGS = -O3 -fPIC -std=c++11

F90 = mpif90
F90FLAGS = -O3 -r8 -i4 -fPIC

LD = $(CXX) #-qopenmp
LDFLAGS =

ARCH = ar cr
LDD = $(CXX) -shared

PYTHON = python3

LAPACK = -llapack

HDF5_LIBS = -L$(HDF5_DIR)/lib -lhdf5 -Wl,-rpath,$(HDF5_HOME)/lib
HDF5_INCLUDE = -I$(HDF5_DIR)/include
NETCDF_INCLUDE = -I$(NETCDF_DIR)/include
NETCDF_LIBS = -L$(NETCDF_DIR)/lib -lnetcdf

LIBS = -lstdc++